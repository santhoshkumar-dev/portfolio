# This file is a placeholder for environment variables required to run this project.

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/portfolio

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT Secret for Admin Sessions (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password
